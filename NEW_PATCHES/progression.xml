<configs>

	<!-- Agility: +10% run speed per Agility level (1 => 10%, 10 => 100%) -->
	<append xpath="/progression/attributes/attribute[@name='attAgility']">
		<effect_group>
			<passive_effect name="RunSpeed" operation="perc_add" level="1,10" value=".1,1" />
			<passive_effect name="WalkSpeed" operation="perc_add" level="1,10" value=".1,1" />
		</effect_group>
	</append>

	<!-- Fortitude: +10% stamina recovery per Fortitude level (1 => 10%, 10 => 100%) -->
	<append xpath="/progression/attributes/attribute[@name='attFortitude']">
		<effect_group>
			<!-- Used by coffee and cardio perks as a stamina regen modifier -->
			<passive_effect name="StaminaChangeOT" operation="perc_add" level="1,10" value=".1,1" />
		</effect_group>
	</append>

	<!-- Intellect: +10% XP gain per Intellect level (1 => 10%, 10 => 100%) -->
	<append xpath="/progression/attributes/attribute[@name='attIntellect']">
		<effect_group>
			<!-- Global XP multiplier hook (used in vanilla buffs) -->
			<passive_effect name="ExperienceGain" operation="perc_add" level="1,10" value=".1,1" />
		</effect_group>
	</append>

	<!-- Strength: up to -30% stamina cost for attacks (linear; 1 => 0%, 10 => -30%) -->
	<append xpath="/progression/attributes/attribute[@name='attStrength']">
		<effect_group>
			<!-- Primary = regular attack; Secondary = power attack -->
			<passive_effect name="StaminaLoss" operation="perc_add" level="1,10" value="0,-.3"
				tags="primary" />
			<passive_effect name="StaminaLoss" operation="perc_add" level="1,10" value="0,-.3"
				tags="secondary" />
		</effect_group>
	</append>

	<!-- Perception: +10% loot quantity per Perception level (1 => 10%, 10 => 100%) -->
	<append xpath="/progression/attributes/attribute[@name='attPerception']">
		<effect_group>
			<!-- LootQuantity is tag-scoped in vanilla; this targets the common Lucky Looter
			categories -->
			<passive_effect name="LootQuantity" operation="perc_add" level="1,10" value=".1,1"
				tags="ammo,food,medical,junk,dukes,brass,lead,gems" />

			<!-- Crit chance: up to +20% at Perception 10 (linear: 1 => +2%, 10 => +20%) -->
			<passive_effect name="CriticalChance" operation="base_add" level="1,10" value=".02,.2" />
		</effect_group>
	</append>

	<!-- Parkour: +1m jump height per Parkour rank (1 => +1m, 5 => +5m) -->
	<!--
		Vanilla notes JumpStrength scaling is multiplicative off an ~1.6m base jump.
		So for +Nm we use perc_add = ((1.6 + N) / 1.6) - 1.
		Rank 1..5 => 0.625, 1.25, 1.875, 2.5, 3.125
	-->
	<set
		xpath="/progression/perk[@name='perkParkour']/effect_group/passive_effect[@name='JumpStrength']/@level">
		1,2,3,4,5</set>
	<set
		xpath="/progression/perk[@name='perkParkour']/effect_group/passive_effect[@name='JumpStrength']/@value">
		.625,1.25,1.875,2.5,3.125</set>

	<!-- Mother Lode: harvest starts at +100% and scales to +200% -->
	<set
		xpath="/progression/perk[@name='perkMotherLode']/effect_group/passive_effect[@name='HarvestCount' and @tags='oreWoodHarvest']/@value">
		1,2</set>

	<!-- Counterbalance: reduce Harvesting XP roughly inverse to yield (rank1: -50%, rank5: -66.67%) -->
	<set
		xpath="/progression/perk[@name='perkMotherLode']/effect_group/passive_effect[@name='PlayerExpGain' and @tags='Harvesting']/@value">
		-.5,-.6667</set>

	<!-- Intellect Mastery: Bookworm chance to loot an additional book/mag/schematic -->
	<set
		xpath="/progression/perk[@name='perkIntellectMastery']/effect_group/triggered_effect[@cvar='$perkBookwormChance' and requirement[@operation='GTE']]/@value">
		95</set>

</configs>
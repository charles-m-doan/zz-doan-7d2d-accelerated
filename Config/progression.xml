<configs>

	<!-- Skill Points Per Level -->
	<set xpath="/progression/level/@skill_points_per_level">3</set>

	<!-- Agility: +8% walk speed per Agility level (1 => 8%, 10 => 80%) -->
	<!-- Agility: +15% run speed per Agility level (1 => 15%, 10 => 150%) -->
	<append xpath="/progression/attributes/attribute[@name='attAgility']">
		<effect_group>
			<passive_effect name="WalkSpeed" operation="perc_add" level="1,10" value=".08,.8" />
			<passive_effect name="RunSpeed" operation="perc_add" level="1,10" value=".15,1.5" />
		</effect_group>
	</append>

	<!-- Fortitude: +10% stamina recovery per Fortitude level (1 => 10%, 10 => 100%) -->
	<append xpath="/progression/attributes/attribute[@name='attFortitude']">
		<effect_group>
			<!-- Used by coffee and cardio perks as a stamina regen modifier -->
			<passive_effect name="StaminaChangeOT" operation="perc_add" level="1,10" value=".1,1" />
		</effect_group>
	</append>

	<!-- Intellect: +20% XP gain per Intellect level (1 => 20%, 10 => 200%) -->
	<append xpath="/progression/attributes/attribute[@name='attIntellect']">
		<effect_group>
			<!-- Global XP multiplier hook (used in vanilla buffs) -->
			<passive_effect name="ExperienceGain" operation="perc_add" level="1,10" value=".2,2" />
		</effect_group>
	</append>

	<!-- Strength: up to -30% stamina cost for melee attacks (linear; 1 => 3%, 10 => -30%) -->
	<append xpath="/progression/attributes/attribute[@name='attStrength']">
		<effect_group>
			<!-- Primary = regular attack; Secondary = power attack -->
			<passive_effect name="StaminaLoss" operation="perc_add" level="1,10" value="-.03,-.3"
				tags="primary" />
			<passive_effect name="StaminaLoss" operation="perc_add" level="1,10" value="-.03,-.3"
				tags="secondary" />
		</effect_group>
	</append>

	<!-- Perception: +20% loot quantity per Perception level (1 => 20%, 10 => 200%) -->
	<append xpath="/progression/attributes/attribute[@name='attPerception']">
		<effect_group>
			<!-- LootQuantity is tag-scoped in vanilla; this targets the common Lucky Looter
			categories -->
			<passive_effect name="LootQuantity" operation="perc_add" level="1,10" value=".2,2"
				tags="ammo,food,medical,junk,dukes,brass,lead,gems" />
			<!-- Crit chance: up to +20% at Perception 10 (linear: 1 => +2%, 10 => +20%) -->
			<passive_effect name="CriticalChance" operation="base_add" level="1,10" value=".02,.2" />
		</effect_group>
	</append>

	<!-- Parkour: Jump Strength levels -->
	<!-- <passive_effect name="HarvestCount" operation="perc_add" level="1,5" value=".2,1"
	tags="oreWoodHarvest"/> -->

	<!-- <passive_effect name="JumpStrength" operation="perc_add" level="2,3,4,5"
	value=".39,.39,.75,.75"/> -->
	<set
		xpath="/progression/perks/perk[@name='perkParkour']/effect_group/passive_effect[@name='JumpStrength']/@level">
		1,5</set>
	<set
		xpath="/progression/perks/perk[@name='perkParkour']/effect_group/passive_effect[@name='JumpStrength']/@value">
		0.25,1.25</set>

	<!-- Mother Lode: harvest starts at +100% and scales to +200% -->
	<set
		xpath="/progression/perks/perk[@name='perkMotherLode']/effect_group/passive_effect[@name='HarvestCount']/@value">
		1.2,3.2</set>

	<!-- Counterbalance: reduce Harvesting XP roughly inverse to yield (rank1: -50%, rank5: -66.67%) -->
	<set
		xpath="/progression/perks/perk[@name='perkMotherLode']/effect_group/passive_effect[@name='PlayerExpGain' and @tags='Harvesting']/@value">
		-.5,-.6667</set>

</configs>
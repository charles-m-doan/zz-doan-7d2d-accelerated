<configs>

    <!-- Bird nests: 3x feathers, higher egg probability -->
    <set
        xpath="/lootcontainers/lootgroup[@name='groupBirdNest01']/item[@name='resourceFeather']/@count">
        3</set>
    <set
        xpath="/lootcontainers/lootgroup[@name='groupBirdNest02']/item[@name='resourceFeather']/@count">
        3,15</set>
    <set
        xpath="/lootcontainers/lootgroup[@name='groupBirdNest02']/item[@name='foodEgg']/@loot_prob_template">
        high</set>

    <!-- Books -->

    <!-- Crafting skill magazines: whenever one drops, drop 1-5 copies -->
    <set xpath="/lootcontainers//item[@group='skillMagazines']/@count">1,5</set>
    <set xpath="/lootcontainers//item[contains(@name,'SkillMagazine') and @count]/@count">1,5</set>

    <append xpath="/lootcontainers/lootgroup[@name='groupCars']">
        <item group="skillMagazines" count="1" />
        <item group="perkBooks" count="1" />
    </append>

    <append xpath="/lootcontainers/lootgroup[@name='groupMailbox']">
        <item group="skillMagazines" count="1" />
        <item group="perkBooks" count="1" />
    </append>

    <!-- Backpacks: always drop 3 extra -->
    <append xpath="/lootcontainers/lootgroup[@name='groupBackpacks']">
        <item group="skillMagazines" count="4" />
        <item group="perkBooks" count="1" />
    </append>

</configs>
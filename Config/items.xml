	<!-- Forging / Smelting Stuff -->
	<!-- original value: .25 -->
	<set xpath="/items/item[@name='unit_iron']/property[@name='MeltTimePerUnit']/@value">0.2</set>
	<!-- original value: .4 -->
	<set xpath="/items/item[@name='unit_brass']/property[@name='MeltTimePerUnit']/@value">0.3</set>

	<append xpath="/items/item[@name='toolForgeCrucible']">
		<effect_group tiered="false">
			<passive_effect name="CraftingTime" operation="perc_add" value="-.333" />
			<passive_effect name="CraftingSmeltTime" operation="perc_add" value="-.333" />
		</effect_group>
	</append>


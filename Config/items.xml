<configs>
	<!-- Modify Stack Counts for all Items -->
	<set xpath="/items/item/property[@name='Stacknumber']/@value">50000</set>

	<!-- Machete -->
	<!-- original value: 25 -->
	<set
		xpath="/items/item[@name='meleeWpnBladeT3Machete']/effect_group[@name='meleeWpnBladeT3Machete']/passive_effect[@name='EntityDamage' and @operation='base_set']/@value">
		30</set>
	<!-- original value: 65 -->
	<set
		xpath="/items/item[@name='meleeWpnBladeT3Machete']/effect_group[@name='meleeWpnBladeT3Machete']/passive_effect[@name='AttacksPerMinute' and @operation='base_set']/@value">
		75</set>
	<!-- original value: 2.3 -->
	<set
		xpath="/items/item[@name='meleeWpnBladeT3Machete']/effect_group[@name='meleeWpnBladeT3Machete']/passive_effect[@name='MaxRange' and @operation='base_set']/@value">
		2.6</set>


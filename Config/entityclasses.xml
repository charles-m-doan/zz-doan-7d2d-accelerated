<configs>

    <!-- Disable XP gains from harvesting (digging, chopping, mining, salvaging, harvesting corpses) -->
    <!-- Implemented as a global PlayerExpGain multiplier on the player entity. -->
    <append xpath="/entity_classes/entity_class[@name='playerMale']">
        <effect_group>
            <passive_effect name="PlayerExpGain" operation="perc_add" value="-1" tags="Harvesting" />
        </effect_group>
    </append>

    <!-- Stag -->
    <!-- original value: 30 -->
    <set
        xpath="/entity_classes/entity_class[@name='animalStag']/drop[@event='Harvest' and @tag='butcherHarvest' and @name='foodRawMeat']/@count">
        60</set>
    <!-- original value: 9 -->
    <set
        xpath="/entity_classes/entity_class[@name='animalStag']/drop[@event='Harvest' and @tag='butcherHarvest' and @name='resourceLeather']/@count">
        18</set>
    <!-- original value: 3 -->
    <set
        xpath="/entity_classes/entity_class[@name='animalStag']/drop[@event='Harvest' and @tag='butcherHarvest' and @name='resourceAnimalFat']/@count">
        6</set>
    <!-- original value: 7 -->
    <set
        xpath="/entity_classes/entity_class[@name='animalStag']/drop[@event='Harvest' and @tag='allToolsHarvest' and @name='resourceBone']/@count">
